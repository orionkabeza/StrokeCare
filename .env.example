# Owner: Orion Kabeza (DevOps) · AI-assisted draft, see AI_USE_LOG.md
# Copy to .env for local work. NEVER commit a real .env, and never put real secrets in this file.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://strokecare:strokecare@localhost:5432/strokecare
DATABASE_SSL_REQUIRE=0
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Behind a proxy (Render, Fly, nginx...), set how many proxies sit in front so login throttling sees real client IPs
# NUM_PROXIES=1
# Demo data is for development and the course demo only. Never switch this on with real users.
ALLOW_DEMO_DATA=1
# Scheduler endpoint secret (POST /api/v1/internal/jobs/run/). Leave empty to switch the endpoint off.
CRON_SECRET=
# Where the web app's files are (the Dockerfile sets this). Default: ../frontend/site (plain files, no build step)
# FRONTEND_DIST=/app/frontend_dist
