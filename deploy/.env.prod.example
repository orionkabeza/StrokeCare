# Owner: Orion Kabeza (DevOps)
# Copy to ".env" next to docker-compose.prod.yml. Never commit the real .env.
# Name people will type. No domain? Use  <your-server-public-ip-with-dashes>.sslip.io  e.g. 129-151-10-20.sslip.io
DOMAIN=strokecare.example.org
# Make each one long and random:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
# Only if you use .github/workflows/scheduler.yml instead of the worker. Leave empty otherwise.
CRON_SECRET=
# 1 only for the course demo with fictional data. Never with real people.
ALLOW_DEMO_DATA=0
