erDiagram
  AuditLog {
    BigAutoField id PK
    DateTimeField at
    ForeignKey actor FK
    ForeignKey subject FK
    CharField action
    CharField object_type
    CharField object_id
    JSONField metadata
  }
  User {
    CharField password
    DateTimeField last_login
    BooleanField is_superuser
    UUIDField id PK
    CharField email
    CharField display_name
    CharField role
    CharField preferred_language
    CharField timezone
    DateTimeField professional_verified_at
    CharField professional_ref
    BooleanField is_active
    BooleanField is_staff
    DateTimeField created_at
  }
  Consent {
    UUIDField id PK
    ForeignKey user FK
    CharField kind
    CharField version
    DateTimeField granted_at
    DateTimeField revoked_at
  }
  AccessibilityPreference {
    BigAutoField id PK
    OneToOneField user FK
    PositiveSmallIntegerField text_scale
    CharField theme
    BooleanField high_contrast
    BooleanField easy_read_font
    BooleanField reduce_motion
    BooleanField audio_first
    BooleanField one_question_at_a_time
    BooleanField one_handed_layout
    BooleanField low_data_mode
    DateTimeField updated_at
  }
  CareLink {
    UUIDField id PK
    ForeignKey patient FK
    ForeignKey member FK
    CharField relation
    CharField label
    ArrayField scopes
    CharField status
    CharField invite_hash
    DateTimeField invite_expires_at
    DateTimeField created_at
    DateTimeField activated_at
    DateTimeField revoked_at
  }
  Alert {
    UUIDField id PK
    ForeignKey recipient FK
    ForeignKey patient FK
    CharField kind
    CharField dedupe_key
    JSONField detail
    DateTimeField created_at
    DateTimeField read_at
  }
  BPReading {
    UUIDField id PK
    ForeignKey user FK
    PositiveSmallIntegerField systolic
    PositiveSmallIntegerField diastolic
    PositiveSmallIntegerField pulse
    DateTimeField taken_at
    CharField context
    CharField note
    ForeignKey entered_by FK
    DateTimeField created_at
  }
  RecoveryPlan {
    UUIDField id PK
    OneToOneField patient FK
    CharField title
    TextField notes_for_patient
    ForeignKey created_by FK
    DateTimeField created_at
    DateTimeField updated_at
  }
  PlanTask {
    UUIDField id PK
    ForeignKey plan FK
    CharField title
    TextField instructions
    PositiveSmallIntegerField order
    BooleanField is_active
    ForeignKey created_by FK
    DateTimeField created_at
  }
  TaskLog {
    UUIDField id PK
    ForeignKey task FK
    DateField date
    CharField note
    ForeignKey entered_by FK
    DateTimeField created_at
  }
  CheckInQuestion {
    BigAutoField id PK
    SlugField code
    JSONField prompt
    CharField answer_type
    JSONField choices
    JSONField urgent_values
    PositiveSmallIntegerField order
    BooleanField is_active
    CharField status
    CharField source
    CharField reviewed_by_name
    DateTimeField reviewed_at
  }
  CheckIn {
    UUIDField id PK
    ForeignKey user FK
    DateField date
    DateTimeField submitted_at
    BooleanField urgent_answered
    ForeignKey entered_by FK
  }
  CheckInAnswer {
    BigAutoField id PK
    ForeignKey checkin FK
    ForeignKey question FK
    JSONField value
    BooleanField skipped
  }
  Reminder {
    UUIDField id PK
    ForeignKey user FK
    CharField kind
    TimeField time_of_day
    ArrayField days_of_week
    CharField channel
    BooleanField is_active
    DateTimeField created_at
  }
  Medication {
    UUIDField id PK
    ForeignKey patient FK
    CharField name
    CharField dose
    TextField instructions
    ArrayField times
    ArrayField days_of_week
    DateField start_date
    DateField end_date
    BooleanField is_active
    ForeignKey created_by FK
    DateTimeField created_at
  }
  MedicationDose {
    UUIDField id PK
    ForeignKey medication FK
    DateField date
    TimeField time
    DateTimeField taken_at
    ForeignKey entered_by FK
  }
  VisitQuestion {
    UUIDField id PK
    ForeignKey patient FK
    CharField text
    ForeignKey entered_by FK
    DateTimeField created_at
    DateTimeField discussed_at
  }
  PlanTemplate {
    UUIDField id PK
    ForeignKey owner FK
    CharField name
    JSONField tasks
    DateTimeField created_at
  }
  VoiceNote {
    UUIDField id PK
    ForeignKey patient FK
    ForeignKey recorded_by FK
    CharField context
    BinaryField audio
    CharField content_type
    PositiveIntegerField size_bytes
    PositiveSmallIntegerField duration_seconds
    DateTimeField created_at
  }
  EducationItem {
    UUIDField id PK
    SlugField slug
    CharField kind
    CharField audience
    CharField source_name
    CharField source_url
    CharField status
    CharField reviewed_by_name
    DateTimeField reviewed_at
    DateField review_due_at
    BooleanField is_published
    DateTimeField created_at
    DateTimeField updated_at
  }
  EducationTranslation {
    BigAutoField id PK
    ForeignKey item FK
    CharField locale
    CharField title
    CharField summary
    TextField body
    CharField video_url
    CharField status
    CharField reviewed_by_name
    DateTimeField reviewed_at
  }
  EmergencyContact {
    UUIDField id PK
    CharField region
    CharField label
    CharField kind
    CharField phone
    CharField hours
    CharField verified_by_name
    DateTimeField verified_at
    DateTimeField last_checked_at
    BooleanField is_active
  }
  TalkPhrase {
    BigAutoField id PK
    SlugField code
    CharField category
    JSONField label
    CharField icon
    PositiveSmallIntegerField order
    BooleanField is_active
    CharField status
    CharField reviewed_by_name
    DateTimeField reviewed_at
  }
  Message {
    UUIDField id PK
    ForeignKey patient FK
    ForeignKey sender FK
    TextField body
    DateTimeField created_at
  }
  ThreadRead {
    BigAutoField id PK
    ForeignKey patient FK
    ForeignKey user FK
    DateTimeField last_read_at
  }
  CareEvent {
    UUIDField id PK
    ForeignKey patient FK
    CharField title
    CharField kind
    DateTimeField starts_at
    DateTimeField ends_at
    CharField location
    CharField notes
    PositiveIntegerField remind_minutes_before
    ForeignKey assigned_to FK
    DateTimeField done_at
    ForeignKey created_by FK
    DateTimeField created_at
  }
  HandoverNote {
    UUIDField id PK
    ForeignKey patient FK
    CharField text
    ForeignKey created_by FK
    DateTimeField created_at
  }
  HomeVisit {
    UUIDField id PK
    UUIDField client_id
    ForeignKey patient FK
    ForeignKey chw FK
    DateTimeField visited_at
    JSONField checklist
    CharField note
    ForeignKey reading FK
    DateTimeField received_at
  }
  Goal {
    UUIDField id PK
    ForeignKey patient FK
    CharField text
    DateField target_date
    DateTimeField done_at
    ForeignKey entered_by FK
    DateTimeField created_at
  }
  CarePhase {
    UUIDField id PK
    ForeignKey patient FK
    CharField name
    DateField starts_on
    DateField ends_on
    TextField care_needed
    ForeignKey created_by FK
    DateTimeField created_at
  }
  MobilityLog {
    UUIDField id PK
    ForeignKey patient FK
    DateField date
    CharField kind
    PositiveSmallIntegerField minutes
    CharField help
    CharField note
    ForeignKey entered_by FK
    UUIDField client_id
    DateTimeField created_at
  }
  CustomPhrase {
    UUIDField id PK
    ForeignKey patient FK
    CharField text
    CharField icon
    ForeignKey entered_by FK
    DateTimeField created_at
  }
